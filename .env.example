# =====================================================================
# Painel de observabilidade — variáveis (preencher no Railway, aba Variables)
# NUNCA comite o .env preenchido.
# =====================================================================

# Chave que assina o cookie de login. Uma frase longa e aleatória (30+ caracteres).
# Trocar derruba todas as sessões abertas.
PAINEL_SEGREDO=

# Quem pode entrar: "Nome:codigo;Nome:codigo". Códigos com 10+ caracteres.
# O nome de quem entrou vem do código. Tirar alguém da lista derruba a sessão.
# Ex.: PAINEL_EQUIPE=Gabriel:troque-este-codigo;Yuri:outro-codigo-longo
PAINEL_EQUIPE=

# Token do GitHub SÓ DE LEITURA (fine-grained): github.com → Settings →
# Developer settings → Personal access tokens → Fine-grained tokens.
# Repositórios: só os que o painel acompanha. Permissões: Contents = Read-only
# (Metadata = Read-only vem junto). Sem ele, repositórios privados não aparecem.
GITHUB_TOKEN=

# Token do Railway (opcional) para mostrar o último deploy: railway.com →
# Account Settings → Tokens. Sem ele, o bloco "Deploys no Railway" fica "sem dados".
RAILWAY_TOKEN=
